<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Tokens de cor com nome ("Estilo C": verde e neutros). É o ÚNICO lugar com valores hexadecimais do aplicativo:
    estilos e telas só referenciam estes nomes com DynamicResource (ou por classes), então trocar de tema atualiza tudo ao vivo.
    Cores com 8 dígitos (#AARRGGBB) são semitransparentes: o cartão translúcido é branco com opacidade, sem desfoque real.
    Os pares texto/fundo usados têm contraste de pelo menos 4,5:1 nos dois temas (verificado por script).
    Grupos: fundo e superfícies; texto; botões (primário verde, "ink" preto); estados (positivo, alerta, negativo, cada um com
    cor de texto, fundo suave e cor de barra); chips; cartão escuro de resumo; gráfico; avatares, menu e sombras; e, no fim,
    os diálogos sobrepostos (camada escura, botão de fechar, painéis, avisos) e a barra flutuante do modo de seleção.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <LinearGradientBrush x:Key="BgBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#E8F3FA" Offset="0"/>
        <GradientStop Color="#F6F7FB" Offset="0.48"/>
        <GradientStop Color="#F1EBFA" Offset="1"/>
      </LinearGradientBrush>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#B8FFFFFF"/>
      <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#E6FFFFFF"/>
      <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="LineBrush" Color="#12141828"/>
      <SolidColorBrush x:Key="InputBorderBrush" Color="#2E141828"/>
      <SolidColorBrush x:Key="TextBrush" Color="#14161A"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F6470"/>
      <SolidColorBrush x:Key="TextSupportBrush" Color="#333B47"/>
      <SolidColorBrush x:Key="PrimaryBrush" Color="#0B7A5A"/>
      <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#096A4E"/>
      <SolidColorBrush x:Key="InkBrush" Color="#14161A"/>
      <SolidColorBrush x:Key="OnInkBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="InkHoverBrush" Color="#2C2F37"/>
      <SolidColorBrush x:Key="PositiveBrush" Color="#0B7A5A"/>
      <SolidColorBrush x:Key="PositiveSoftBrush" Color="#E3F4EC"/>
      <SolidColorBrush x:Key="ProgressOkBrush" Color="#12A072"/>
      <SolidColorBrush x:Key="WarnBrush" Color="#8A5A00"/>
      <SolidColorBrush x:Key="WarnSoftBrush" Color="#FBF0D5"/>
      <SolidColorBrush x:Key="ProgressWarnBrush" Color="#F2B90C"/>
      <SolidColorBrush x:Key="NegativeBrush" Color="#B42318"/>
      <SolidColorBrush x:Key="NegativeSoftBrush" Color="#FCE4E4"/>
      <SolidColorBrush x:Key="ProgressOverBrush" Color="#E5484D"/>
      <SolidColorBrush x:Key="ChipBrush" Color="#F3F3F2"/>
      <SolidColorBrush x:Key="ChipTextBrush" Color="#444444"/>
      <SolidColorBrush x:Key="ChipStatusBrush" Color="#F1F2F5"/>
      <LinearGradientBrush x:Key="SummaryBrush" StartPoint="20%,0%" EndPoint="80%,100%">
        <GradientStop Color="#4A4D55" Offset="0"/>
        <GradientStop Color="#1B1D22" Offset="1"/>
      </LinearGradientBrush>
      <SolidColorBrush x:Key="OnSummaryBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="OnSummarySecondaryBrush" Color="#D5D8DE"/>
      <SolidColorBrush x:Key="SummaryTrackBrush" Color="#38FFFFFF"/>
      <SolidColorBrush x:Key="ChartBarBrush" Color="#E1E5EC"/>
      <SolidColorBrush x:Key="ChartSelectedBrush" Color="#14161A"/>
      <SolidColorBrush x:Key="ChartBalloonBrush" Color="#14161A"/>
      <SolidColorBrush x:Key="ChartBalloonTextBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="ChartGridBrush" Color="#33141828"/>
      <SolidColorBrush x:Key="AvatarBrush" Color="#E1E5EC"/>
      <SolidColorBrush x:Key="NavActiveBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="HoverBrush" Color="#0F141828"/>
      <SolidColorBrush x:Key="TrackBrush" Color="#E6E9EF"/>
      <SolidColorBrush x:Key="ScrimBrush" Color="#6B141828"/>
      <SolidColorBrush x:Key="CloseBrush" Color="#F5F4F3"/>
      <SolidColorBrush x:Key="PanelBrush" Color="#F5F6FA"/>
      <SolidColorBrush x:Key="WarnStrongBrush" Color="#6B4600"/>
      <SolidColorBrush x:Key="PositiveStrongBrush" Color="#0B5C44"/>
      <SolidColorBrush x:Key="SelectedRowBrush" Color="#1F12A072"/>
      <SolidColorBrush x:Key="BarActionBrush" Color="#12A072"/>
      <SolidColorBrush x:Key="OnBarActionBrush" Color="#14161A"/>
      <SolidColorBrush x:Key="OnInkSecondaryBrush" Color="#D5D8DE"/>
      <!-- Sombras: no tema escuro quase não aparecem, então ficam curtas e discretas. -->
      <BoxShadows x:Key="CardShadow">0 1 2 0 #0A141828, 0 10 30 0 #0D141828</BoxShadows>
      <BoxShadows x:Key="SolidShadow">0 1 2 0 #0A141828, 0 4 14 0 #0A141828</BoxShadows>
      <BoxShadows x:Key="SummaryShadow">0 16 28 0 #40141828</BoxShadows>
      <BoxShadows x:Key="NavShadow">0 1 2 0 #0F141828, 0 2 8 0 #0A141828</BoxShadows>
      <BoxShadows x:Key="ModalShadow">0 24 60 0 #59141828</BoxShadows>
      <BoxShadows x:Key="BarShadow">0 12 30 0 #40141828</BoxShadows>
      <!-- Cor de destaque dos controles do Fluent (caixas de seleção, foco): o verde primário. -->
      <Color x:Key="SystemAccentColor">#0B7A5A</Color>
      <Color x:Key="SystemAccentColorLight1">#0B7A5A</Color>
      <Color x:Key="SystemAccentColorLight2">#0B7A5A</Color>
      <Color x:Key="SystemAccentColorDark1">#096A4E</Color>
      <Color x:Key="SystemAccentColorDark2">#096A4E</Color>
      <!-- Faz os controles do Fluent (campos, listas, menus, foco) usarem os mesmos tokens. -->
      <StaticResource x:Key="TextControlBackground" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="TextControlBorderBrush" ResourceKey="InputBorderBrush"/>
      <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="TextSecondaryBrush"/>
      <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="PrimaryBrush"/>
      <StaticResource x:Key="TextControlForeground" ResourceKey="TextBrush"/>
      <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextSecondaryBrush"/>
      <StaticResource x:Key="ComboBoxBackground" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="InputBorderBrush"/>
      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="TextSecondaryBrush"/>
      <StaticResource x:Key="ComboBoxForeground" ResourceKey="TextBrush"/>
      <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="LineBrush"/>
      <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="HoverBrush"/>
      <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="PositiveSoftBrush"/>
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="PositiveSoftBrush"/>
      <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="LineBrush"/>
      <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="HoverBrush"/>
      <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="TextBrush"/>
      <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="TextBrush"/>
      <!-- Caixas de marcação ligadas: verde primário, no lugar do azul padrão do Fluent. -->
      <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="PrimaryBrush"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="PrimaryHoverBrush"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="PrimaryHoverBrush"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="PrimaryBrush"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="PrimaryHoverBrush"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="PrimaryHoverBrush"/>
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="OnPrimaryBrush"/>
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="OnPrimaryBrush"/>
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="OnPrimaryBrush"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <LinearGradientBrush x:Key="BgBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#0D1117" Offset="0"/>
        <GradientStop Color="#12141B" Offset="0.48"/>
        <GradientStop Color="#15121D" Offset="1"/>
      </LinearGradientBrush>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#0FFFFFFF"/>
      <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#1C1F27"/>
      <SolidColorBrush x:Key="LineBrush" Color="#17FFFFFF"/>
      <SolidColorBrush x:Key="InputBorderBrush" Color="#33FFFFFF"/>
      <SolidColorBrush x:Key="TextBrush" Color="#F2F3F5"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A8B3"/>
      <SolidColorBrush x:Key="TextSupportBrush" Color="#D0D4DB"/>
      <SolidColorBrush x:Key="PrimaryBrush" Color="#2BBF93"/>
      <SolidColorBrush x:Key="OnPrimaryBrush" Color="#06251C"/>
      <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#45CFA6"/>
      <SolidColorBrush x:Key="InkBrush" Color="#F2F3F5"/>
      <SolidColorBrush x:Key="OnInkBrush" Color="#14161A"/>
      <SolidColorBrush x:Key="InkHoverBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="PositiveBrush" Color="#34D1A0"/>
      <SolidColorBrush x:Key="PositiveSoftBrush" Color="#2634D1A0"/>
      <SolidColorBrush x:Key="ProgressOkBrush" Color="#34D1A0"/>
      <SolidColorBrush x:Key="WarnBrush" Color="#F5C84B"/>
      <SolidColorBrush x:Key="WarnSoftBrush" Color="#26F5C84B"/>
      <SolidColorBrush x:Key="ProgressWarnBrush" Color="#F5C84B"/>
      <SolidColorBrush x:Key="NegativeBrush" Color="#FF7A7E"/>
      <SolidColorBrush x:Key="NegativeSoftBrush" Color="#26FF7A7E"/>
      <SolidColorBrush x:Key="ProgressOverBrush" Color="#FF7A7E"/>
      <SolidColorBrush x:Key="ChipBrush" Color="#17FFFFFF"/>
      <SolidColorBrush x:Key="ChipTextBrush" Color="#D5D8DE"/>
      <SolidColorBrush x:Key="ChipStatusBrush" Color="#24FFFFFF"/>
      <LinearGradientBrush x:Key="SummaryBrush" StartPoint="20%,0%" EndPoint="80%,100%">
        <GradientStop Color="#2A2D35" Offset="0"/>
        <GradientStop Color="#14161B" Offset="1"/>
      </LinearGradientBrush>
      <SolidColorBrush x:Key="OnSummaryBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="OnSummarySecondaryBrush" Color="#D5D8DE"/>
      <SolidColorBrush x:Key="SummaryTrackBrush" Color="#38FFFFFF"/>
      <SolidColorBrush x:Key="ChartBarBrush" Color="#2B303A"/>
      <SolidColorBrush x:Key="ChartSelectedBrush" Color="#F2F3F5"/>
      <SolidColorBrush x:Key="ChartBalloonBrush" Color="#F2F3F5"/>
      <SolidColorBrush x:Key="ChartBalloonTextBrush" Color="#14161A"/>
      <SolidColorBrush x:Key="ChartGridBrush" Color="#33FFFFFF"/>
      <SolidColorBrush x:Key="AvatarBrush" Color="#2B303A"/>
      <SolidColorBrush x:Key="NavActiveBrush" Color="#1AFFFFFF"/>
      <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="TrackBrush" Color="#2B303A"/>
      <SolidColorBrush x:Key="ScrimBrush" Color="#A6000000"/>
      <SolidColorBrush x:Key="CloseBrush" Color="#24FFFFFF"/>
      <SolidColorBrush x:Key="PanelBrush" Color="#0FFFFFFF"/>
      <SolidColorBrush x:Key="WarnStrongBrush" Color="#F5C84B"/>
      <SolidColorBrush x:Key="PositiveStrongBrush" Color="#34D1A0"/>
      <SolidColorBrush x:Key="SelectedRowBrush" Color="#2634D1A0"/>
      <SolidColorBrush x:Key="BarActionBrush" Color="#0B7A5A"/>
      <SolidColorBrush x:Key="OnBarActionBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="OnInkSecondaryBrush" Color="#5F6470"/>
      <!-- Sombras: no tema escuro quase não aparecem, então ficam curtas e discretas. -->
      <BoxShadows x:Key="CardShadow">0 1 2 0 #33000000</BoxShadows>
      <BoxShadows x:Key="SolidShadow">0 1 2 0 #33000000</BoxShadows>
      <BoxShadows x:Key="SummaryShadow">0 16 28 0 #59000000</BoxShadows>
      <BoxShadows x:Key="NavShadow">0 1 2 0 #33000000</BoxShadows>
      <BoxShadows x:Key="ModalShadow">0 24 60 0 #80000000</BoxShadows>
      <BoxShadows x:Key="BarShadow">0 12 30 0 #66000000</BoxShadows>
      <!-- Cor de destaque dos controles do Fluent (caixas de seleção, foco): o verde primário. -->
      <Color x:Key="SystemAccentColor">#2BBF93</Color>
      <Color x:Key="SystemAccentColorLight1">#2BBF93</Color>
      <Color x:Key="SystemAccentColorLight2">#2BBF93</Color>
      <Color x:Key="SystemAccentColorDark1">#45CFA6</Color>
      <Color x:Key="SystemAccentColorDark2">#45CFA6</Color>
      <!-- Faz os controles do Fluent (campos, listas, menus, foco) usarem os mesmos tokens. -->
      <StaticResource x:Key="TextControlBackground" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="TextControlBorderBrush" ResourceKey="InputBorderBrush"/>
      <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="TextSecondaryBrush"/>
      <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="PrimaryBrush"/>
      <StaticResource x:Key="TextControlForeground" ResourceKey="TextBrush"/>
      <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="TextSecondaryBrush"/>
      <StaticResource x:Key="ComboBoxBackground" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="InputBorderBrush"/>
      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="TextSecondaryBrush"/>
      <StaticResource x:Key="ComboBoxForeground" ResourceKey="TextBrush"/>
      <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="LineBrush"/>
      <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="HoverBrush"/>
      <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="PositiveSoftBrush"/>
      <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="PositiveSoftBrush"/>
      <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="SolidSurfaceBrush"/>
      <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="LineBrush"/>
      <StaticResource x:Key="MenuFlyoutItemBackgroundPointerOver" ResourceKey="HoverBrush"/>
      <StaticResource x:Key="MenuFlyoutItemForeground" ResourceKey="TextBrush"/>
      <StaticResource x:Key="MenuFlyoutItemForegroundPointerOver" ResourceKey="TextBrush"/>
      <!-- Caixas de marcação ligadas: verde primário, no lugar do azul padrão do Fluent. -->
      <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="PrimaryBrush"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="PrimaryHoverBrush"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="PrimaryHoverBrush"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="PrimaryBrush"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="PrimaryHoverBrush"/>
      <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="PrimaryHoverBrush"/>
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="OnPrimaryBrush"/>
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="OnPrimaryBrush"/>
      <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="OnPrimaryBrush"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
