<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctl="using:BankManager.Controls">
  <!--
    Estilos dos controles ("Estilo C"). Nenhuma cor é escrita aqui: tudo vem dos tokens de Tokens.axaml via
    DynamicResource. As classes aplicadas por Ui.cs e pelas páginas selecionam os estilos abaixo.
    Lembrete: no Avalonia vale a ORDEM das regras (a última vence), não a especificidade como no CSS.
  -->

  <!-- Base: texto e fundo herdados por toda a janela. O fundo é um degradê claríssimo; os diálogos usam a superfície sólida.
       A fonte Inter embutida é a padrão do aplicativo (Program.cs, WithInterFont); definir FontFamily aqui a trocaria pela do sistema.
       "+tnum" liga os algarismos tabulares (todos com a mesma largura) em todo o aplicativo, para valores alinhados. -->
  <Style Selector="Window">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontFeatures" Value="+tnum"/>
    <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Window.dialog"><Setter Property="Background" Value="{DynamicResource SolidSurfaceBrush}"/></Style>

  <!-- Hierarquia do texto. Estados semânticos: positive, negative, warn e error. -->
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style Selector="TextBlock.support"><Setter Property="Foreground" Value="{DynamicResource TextSupportBrush}"/></Style>
  <Style Selector="TextBlock.brand"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBlock.small"><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="TextBlock.strong"><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <!-- Valores: "hero" é o número grande da visão geral; "kpi" e "money" são valores de destaque médio. -->
  <Style Selector="TextBlock.hero"><Setter Property="FontSize" Value="48"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="TextBlock.kpi"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style Selector="TextBlock.money"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style Selector="TextBlock.positive"><Setter Property="Foreground" Value="{DynamicResource PositiveBrush}"/></Style>
  <Style Selector="TextBlock.negative"><Setter Property="Foreground" Value="{DynamicResource NegativeBrush}"/></Style>
  <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource NegativeBrush}"/></Style>
  <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/></Style>

  <!-- Botões: alvo de clique de pelo menos 40 px, canto 12. Variantes: primary (verde, 44 px), ink (pílula preta), ghost, danger, link e nav. -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="16,8"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource SolidSurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SolidSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Opacity" Value="0.5"/></Style>
  <Style Selector="Button.primary"><Setter Property="MinHeight" Value="44"/><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
  </Style>
  <!-- Botão secundário de destaque ("Registrar acerto"): pílula preta no tema claro, clara no tema escuro. -->
  <Style Selector="Button.ink"><Setter Property="CornerRadius" Value="999"/><Setter Property="Padding" Value="18,8"/><Setter Property="Background" Value="{DynamicResource InkBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnInkBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Button.ink:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ink:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource InkHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnInkBrush}"/>
  </Style>
  <Style Selector="Button.ghost"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Style>
  <Style Selector="Button.round"><Setter Property="CornerRadius" Value="999"/></Style>
  <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource NegativeBrush}"/></Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource NegativeBrush}"/></Style>
  <!-- Link: botão sem borda, com texto de apoio pequeno ("Ver todas"). -->
  <Style Selector="Button.link"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource TextSupportBrush}"/><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <!-- Nome do mês na pílula: tem cara de botão (fundo suave em repouso, borda ao passar o mouse), porque clicar volta ao mês atual. -->
  <Style Selector="Button.month"><Setter Property="CornerRadius" Value="999"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="14,4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Button.month:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.month:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/></Style>
  <!-- Botão quadrado pequeno do menu "⋯" dos cartões de meta. -->
  <Style Selector="Button.square"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="40"/><Setter Property="MinWidth" Value="40"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{DynamicResource ChipBrush}"/></Style>
  <Style Selector="Button.square:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ChipStatusBrush}"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <!-- Item do menu lateral: 44 px de altura, canto 12. O ativo ganha fundo branco com sombra suave. -->
  <Style Selector="Button.nav">
    <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="13"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style Selector="Button.nav.footer"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
  <Style Selector="Button.nav.footer:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
  <Style Selector="Button.nav.active"><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter, Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BoxShadow" Value="{DynamicResource NavShadow}"/>
  </Style>

  <!-- Ícones: um Path de traço dentro de um Viewbox 24x24 (veja Ui.Icon). A cor segue o controle que os contém. -->
  <Style Selector="Path.icon"><Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="StrokeLineCap" Value="Round"/><Setter Property="StrokeJoin" Value="Round"/></Style>
  <Style Selector="Button Path.icon"><Setter Property="Stroke" Value="{DynamicResource TextBrush}"/></Style>
  <Style Selector="Button.nav.footer Path.icon"><Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/></Style>
  <Style Selector="Button.primary Path.icon, Button.primary:pointerover Path.icon"><Setter Property="Stroke" Value="{DynamicResource OnPrimaryBrush}"/></Style>
  <Style Selector="Button.ink Path.icon"><Setter Property="Stroke" Value="{DynamicResource OnInkBrush}"/></Style>
  <Style Selector="Button.danger Path.icon"><Setter Property="Stroke" Value="{DynamicResource NegativeBrush}"/></Style>
  <Style Selector="MenuItem Path.icon"><Setter Property="Stroke" Value="{DynamicResource TextBrush}"/></Style>
  <Style Selector="MenuItem.danger Path.icon"><Setter Property="Stroke" Value="{DynamicResource NegativeBrush}"/></Style>

  <!-- Campos: altura mínima de 42 px, canto 12. As cores vêm dos recursos do Fluent mapeados em Tokens.axaml. -->
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="42"/><Setter Property="CornerRadius" Value="12"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style Selector="ComboBox"><Setter Property="MinHeight" Value="42"/><Setter Property="CornerRadius" Value="12"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>

  <!-- Barras de progresso: verde por padrão; "warn" (âmbar) e "over" (vermelho) para metas; "neutral" e "onsummary" para os demais usos.
       Cada cor de barra tem o seu trilho suave. -->
  <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource ProgressOkBrush}"/><Setter Property="Background" Value="{DynamicResource PositiveSoftBrush}"/><Setter Property="CornerRadius" Value="4"/><Setter Property="MinHeight" Value="4"/><Setter Property="Height" Value="8"/></Style>
  <Style Selector="ProgressBar.warn"><Setter Property="Foreground" Value="{DynamicResource ProgressWarnBrush}"/><Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/></Style>
  <Style Selector="ProgressBar.over"><Setter Property="Foreground" Value="{DynamicResource ProgressOverBrush}"/><Setter Property="Background" Value="{DynamicResource NegativeSoftBrush}"/></Style>
  <Style Selector="ProgressBar.neutral"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="{DynamicResource TrackBrush}"/></Style>
  <Style Selector="ProgressBar.onsummary"><Setter Property="Foreground" Value="{DynamicResource OnSummaryBrush}"/><Setter Property="Background" Value="{DynamicResource SummaryTrackBrush}"/></Style>

  <!-- Superfícies. "card": cartão translúcido (branco com opacidade, sem desfoque real). "solid": cartão branco (metas).
       "summary": cartão escuro em degradê do "Resumo da casa", com texto claro nos dois temas. -->
  <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/><Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/></Style>
  <Style Selector="Border.solid"><Setter Property="Background" Value="{DynamicResource SolidSurfaceBrush}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18"/><Setter Property="BoxShadow" Value="{DynamicResource SolidShadow}"/></Style>
  <Style Selector="Border.summary"><Setter Property="Background" Value="{DynamicResource SummaryBrush}"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="24"/><Setter Property="BoxShadow" Value="{DynamicResource SummaryShadow}"/></Style>
  <Style Selector="Border.summary TextBlock"><Setter Property="Foreground" Value="{DynamicResource OnSummaryBrush}"/></Style>
  <Style Selector="Border.summary TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource OnSummarySecondaryBrush}"/></Style>
  <Style Selector="Border.notice"><Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14,10"/></Style>
  <Style Selector="Border.notice.positive"><Setter Property="Background" Value="{DynamicResource PositiveSoftBrush}"/></Style>
  <!-- Linha divisória fina entre linhas de listas. -->
  <Style Selector="Border.divider"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource LineBrush}"/></Style>
  <!-- Pílula translúcida da navegação de mês (‹ mês ›), com 44 px de altura. -->
  <Style Selector="Border.pill"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="999"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="2,0"/><Setter Property="BoxShadow" Value="{DynamicResource NavShadow}"/></Style>

  <!-- Chips. Neutro por padrão; "status" (situação neutra), "warn" (prazo próximo), "positive" (pago) e "negative" (em atraso). -->
  <Style Selector="Border.chip"><Setter Property="Background" Value="{DynamicResource ChipBrush}"/><Setter Property="CornerRadius" Value="999"/><Setter Property="Padding" Value="10,4"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Border.chip > TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource ChipTextBrush}"/></Style>
  <Style Selector="Border.chip.status"><Setter Property="Background" Value="{DynamicResource ChipStatusBrush}"/></Style>
  <Style Selector="Border.chip.status > TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style Selector="Border.chip.warn"><Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/></Style>
  <Style Selector="Border.chip.warn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/></Style>
  <Style Selector="Border.chip.positive"><Setter Property="Background" Value="{DynamicResource PositiveSoftBrush}"/></Style>
  <Style Selector="Border.chip.positive > TextBlock"><Setter Property="Foreground" Value="{DynamicResource PositiveBrush}"/></Style>
  <Style Selector="Border.chip.negative"><Setter Property="Background" Value="{DynamicResource NegativeSoftBrush}"/></Style>
  <Style Selector="Border.chip.negative > TextBlock"><Setter Property="Foreground" Value="{DynamicResource NegativeBrush}"/></Style>

  <!-- Avatar com a inicial da pessoa: neutro por padrão, "strong" (preto) para destacar quem recebe. -->
  <Style Selector="Border.avatar"><Setter Property="Background" Value="{DynamicResource AvatarBrush}"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/></Style>
  <Style Selector="Border.avatar > TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Border.avatar.strong"><Setter Property="Background" Value="{DynamicResource InkBrush}"/></Style>
  <Style Selector="Border.avatar.strong > TextBlock"><Setter Property="Foreground" Value="{DynamicResource OnInkBrush}"/></Style>
  <Style Selector="Border.avatar.large"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="CornerRadius" Value="22"/></Style>
  <!-- Círculo de 36 px com o ícone da categoria; "income" (entrada de dinheiro) fica verde. -->
  <Style Selector="Border.iconcircle"><Setter Property="Background" Value="{DynamicResource SolidSurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Border.iconcircle Path.icon"><Setter Property="Stroke" Value="{DynamicResource TextBrush}"/></Style>
  <Style Selector="Border.iconcircle.income"><Setter Property="Background" Value="{DynamicResource PositiveSoftBrush}"/></Style>
  <Style Selector="Border.iconcircle.income Path.icon"><Setter Property="Stroke" Value="{DynamicResource PositiveBrush}"/></Style>

  <!-- Controle segmentado (Todas / Em aberto / Pagas) e submenu das páginas: a opção ativa fica branca com sombra, como no menu. -->
  <Style Selector="Border.segmented"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="3"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
  <Style Selector="Button.seg"><Setter Property="MinHeight" Value="36"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/></Style>
  <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style Selector="Button.seg.active /template/ ContentPresenter#PART_ContentPresenter, Button.seg.active:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource NavActiveBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BoxShadow" Value="{DynamicResource NavShadow}"/></Style>

  <!-- Cartão de escolha de tema; o selecionado ganha borda verde. -->
  <Style Selector="Button.themecard"><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="16"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/></Style>
  <Style Selector="Button.themecard.selected /template/ ContentPresenter#PART_ContentPresenter, Button.themecard.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
  <!-- Miniaturas desenhadas dentro de um ThemeVariantScope: mostram o tema alvo, não o tema atual. -->
  <Style Selector="Border.mini-frame"><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="ClipToBounds" Value="True"/></Style>
  <Style Selector="Border.mini-bg"><Setter Property="Background" Value="{DynamicResource BgBrush}"/></Style>
  <Style Selector="Border.mini-card"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/></Style>
  <Style Selector="Border.mini-dark"><Setter Property="Background" Value="{DynamicResource SummaryBrush}"/><Setter Property="CornerRadius" Value="4"/></Style>
  <Style Selector="Border.mini-text"><Setter Property="Background" Value="{DynamicResource TextBrush}"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Height" Value="4"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
  <Style Selector="Border.mini-muted"><Setter Property="Background" Value="{DynamicResource ChartBarBrush}"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Height" Value="4"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
  <Style Selector="Border.mini-accent"><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/><Setter Property="CornerRadius" Value="2"/><Setter Property="Height" Value="4"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>

  <!-- Gráfico de barras: o controle desenha a si mesmo e recebe as cores do tema por aqui. -->
  <Style Selector="ctl|BarChart">
    <Setter Property="BarBrush" Value="{DynamicResource ChartBarBrush}"/><Setter Property="SelectedBrush" Value="{DynamicResource ChartSelectedBrush}"/>
    <Setter Property="GridBrush" Value="{DynamicResource ChartGridBrush}"/><Setter Property="LabelBrush" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="BalloonBrush" Value="{DynamicResource ChartBalloonBrush}"/><Setter Property="BalloonTextBrush" Value="{DynamicResource ChartBalloonTextBrush}"/>
  </Style>
</Styles>
