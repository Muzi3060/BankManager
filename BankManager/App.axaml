<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BankManager.App">
  <!--
    O tema NÃO é fixo: RequestedThemeVariant fica no padrão (acompanha o sistema) e App.ApplyTheme o ajusta
    conforme a preferência salva. Cores em Styles/Tokens.axaml, ícones em Styles/Icons.axaml,
    estilos dos controles em Styles/Controls.axaml.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://BankManager/Styles/Tokens.axaml"/>
        <ResourceInclude Source="avares://BankManager/Styles/Icons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Fluent fornece os templates dos controles; Controls.axaml aplica a identidade visual por cima. -->
    <FluentTheme />
    <StyleInclude Source="avares://BankManager/Styles/Controls.axaml"/>
  </Application.Styles>
</Application>
