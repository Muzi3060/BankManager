<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="BankManager.Aplicativo">
  <!--
    O tema NÃO é fixo: RequestedThemeVariant fica no padrão (acompanha o sistema) e App.ApplyTheme o ajusta
    conforme a preferência salva. Cores em Estilos/Cores.axaml, ícones em Estilos/Icones.axaml,
    estilos dos controles em Estilos/Controles.axaml.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://BankManager/Estilos/Cores.axaml"/>
        <ResourceInclude Source="avares://BankManager/Estilos/Icones.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- Fluent fornece os templates dos controles; Controles.axaml aplica a identidade visual por cima. -->
    <FluentTheme />
    <StyleInclude Source="avares://BankManager/Estilos/Controles.axaml"/>
  </Application.Styles>
</Application>
